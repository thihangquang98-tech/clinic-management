
{% extends "clinic/base.html" %}

{% block title %}Tạo đơn thuốc | ClinicCare{% endblock %}

{% block page_heading %}Tạo đơn thuốc{% endblock %}

{% block page_subtitle %}
Quản lý đơn thuốc và hướng dẫn sử dụng thuốc cho bệnh nhân
{% endblock %}

{% block content %}
<style>
    .prescription-page {
        display: block !important;
        width: 100%;
        min-height: 300px;
        color: #102b46;
    }

    .prescription-card {
        display: block !important;
        visibility: visible !important;
        opacity: 1 !important;
        background: #fff;
        border: 1px solid #dbe4ef;
        border-radius: 14px;
        padding: 28px;
        margin: 0 auto;
        max-width: 900px;
        box-shadow: 0 4px 18px rgba(20, 45, 75, .08);
    }

    .prescription-card h2 {
        margin: 0 0 8px;
        font-size: 24px;
        color: #102b46;
    }

    .prescription-description {
        margin: 0 0 24px;
        color: #64748b;
        line-height: 1.6;
    }

    .prescription-field {
        margin-bottom: 22px;
    }

    .prescription-field label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #243b53;
    }

    .prescription-field input,
    .prescription-field select,
    .prescription-field textarea {
        display: block;
        box-sizing: border-box;
        width: 100%;
        min-height: 44px;
        padding: 11px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #fff;
        color: #102b46;
        font: inherit;
    }

    .prescription-field textarea {
        min-height: 110px;
        resize: vertical;
    }

    .prescription-field input:focus,
    .prescription-field select:focus,
    .prescription-field textarea:focus {
        outline: 2px solid #93c5fd;
        border-color: #2675e8;
    }

    .prescription-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
    }

    .prescription-actions button,
    .prescription-actions a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 10px 18px;
        border: 0;
        border-radius: 8px;
        text-decoration: none;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
    }

    .prescription-submit {
        background: #2675e8;
        color: #fff;
    }

    .prescription-submit:hover {
        background: #1d5fc0;
    }

    .prescription-cancel {
        background: #eef2f7;
        color: #334155;
    }

    .prescription-error {
        color: #b42318;
        margin-top: 6px;
    }

    @media (max-width: 600px) {
        .prescription-card {
            padding: 18px;
        }
    }
</style>

<div class="prescription-page">
    <section class="prescription-card">
        <h2>Tạo đơn thuốc mới</h2>
        <p class="prescription-description">
            Chọn hồ sơ khám bệnh, nhập lời dặn và lưu đơn thuốc.
        </p>

        <form method="post">
            {% csrf_token %}

            {% if form.non_field_errors %}
                <div class="prescription-error" role="alert">
                    {{ form.non_field_errors }}
                </div>
            {% endif %}

            {% for field in form %}
                <div class="prescription-field">
                    <label for="{{ field.id_for_label }}">
                        {{ field.label }}
                    </label>

                    {{ field }}

                    {% if field.help_text %}
                        <small>{{ field.help_text }}</small>
                    {% endif %}

                    {% for error in field.errors %}
                        <div class="prescription-error" role="alert">
                            {{ error }}
                        </div>
                    {% endfor %}
                </div>
            {% endfor %}

            <div class="prescription-actions">
                <button type="submit" class="prescription-submit">
                    Lưu đơn thuốc
                </button>

                <a href="{% url 'prescriptions' %}"
                   class="prescription-cancel">
                    Quay lại
                </a>
            </div>
        </form>
    </section>
</div>
{% endblock %}

